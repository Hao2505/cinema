# =====================================================================
#  VibeCinema — cấu hình (chép thành .env rồi sửa). KHÔNG commit file .env thật.
#  Production: sửa deploy/.env.production (deploy.sh chép nó thành /opt/vibecinema/.env).
# =====================================================================

# ---- máy chủ
PORT=3300
# chỉ nghe trong máy (nginx đứng trước). Chạy thử trong mạng nhà để điện thoại vào được: HOST=0.0.0.0
HOST=127.0.0.1
# gốc URL công khai cho thẻ chia sẻ (Facebook / Zalo). Để trống = tự suy từ request.
SITE_URL=

# ---- admin: mở trang kèm #admin=<mã> MỘT lần là trình duyệt nhớ (cookie HttpOnly). Để trống = tắt admin.
# Tạo mã: openssl rand -hex 16
ADMIN_TOKEN=

# ---- YouTube Data API v3 (kiểm tra video trước khi cho vào hàng chờ) — xem README mục "Tạo YouTube API key".
# Không có key thì không ai thêm được video. Quota miễn phí 10.000 lượt / ngày; mỗi link mới tốn 1 lượt (có bộ đệm 6 giờ).
YT_API_KEY=
# vùng bắt buộc xem được
YT_REGION=VN
# nhúng ở chế độ bảo mật nâng cao (youtube-nocookie.com)
YT_NOCOOKIE=true

# ---- luật hàng chờ (đề xuất mặc định — chủ dự án duyệt)
# độ dài tối đa một video (phút); admin được thêm video dài tới ADMIN_MAX_VIDEO_MINUTES
MAX_VIDEO_MINUTES=30
ADMIN_MAX_VIDEO_MINUTES=240
# nhận video đang phát trực tiếp; mỗi lượt live chiếu tối đa LIVE_MAX_MINUTES rồi sang bài kế
ALLOW_LIVE=true
LIVE_MAX_MINUTES=30
# mỗi người được chờ tối đa bao nhiêu video
MAX_QUEUE_PER_USER=2
# hàng chờ tối đa của một phòng
MAX_QUEUE=50
# mỗi người thêm video: 2 lần liền, sau đó 1 lần / bấy nhiêu giây
QUEUE_ADD_SECONDS=8
# số link mới một IP được nhờ YouTube kiểm tra mỗi phút (chống đốt quota 10.000 lượt / ngày)
LOOKUPS_PER_IP_MINUTE=6
# bỏ qua khi số phiếu ≥ tỉ lệ này × số người đang có mặt (và ≥ SKIP_VOTE_MIN); người thêm bài bỏ qua bài mình ngay
SKIP_VOTE_RATIO=0.5
SKIP_VOTE_MIN=2
# số người (khác nhau) báo cáo cùng một video đang chiếu thì rạp tự gỡ + chặn video đó
REPORT_AUTOSKIP=3

# ---- phòng
# người / phòng (tính cả người đang kết nối lại). Có 4 rạp (Nhung Đỏ, Công Viên, Đỗ Xe, Bãi Biển), mỗi rạp hàng chờ riêng;
# rạp đầy thì tự mở thêm phòng của chính rạp đó, tối đa MAX_ROOMS phòng MỖI rạp (1–9)
ROOM_CAPACITY=60
MAX_ROOMS=3
# nhịp server gửi vị trí (lần / giây)
TICK_HZ=30

# ---- chống phá
# số kết nối tối đa từ một IP (nhiều người chung wifi / 4G thì nới ra)
MAX_CONN_PER_IP=12
# số lần vào rạp tối đa / phút / IP
JOINS_PER_MINUTE=20
# từ cấm thêm (ngoài danh sách có sẵn), cách nhau bằng dấu phẩy, so khớp nguyên từ có dấu
BLOCK_WORDS=
# tin header CF-Connecting-IP / X-Real-IP (chạy sau Cloudflare + nginx thì để true)
TRUST_PROXY=true
# muối băm IP (để trống = tự tạo, lưu ở data/ip-salt.txt)
IP_SALT=

# ---- lưu trữ (hàng chờ, video bị gỡ, lệnh cấm, báo cáo) trong DATA_DIR
PERSIST=true
DATA_DIR=data

# ---- liên hệ khiếu nại bản quyền hiện trên trang /chinh-sach (để trống = chỉ dùng nút báo cáo)
CONTACT_EMAIL=

# video mặc định: phòng trống video + hàng chờ trống quá DEFAULT_IDLE_SECONDS giây thì rạp tự phát video này (nên là kênh
# trực tiếp 24/7), phát liên tục; có người thêm video là nhường ngay, không bỏ phiếu bỏ qua được. Để trống = tắt.
DEFAULT_VIDEO=rFZHOHl-L8A
DEFAULT_IDLE_SECONDS=30

# ---- phòng riêng (có mật khẩu, miễn phí, không hiện trong danh sách rạp — docs/07 §20)
# "mạng" = IPv4 /32 hoặc IPv6 /64 (đổi địa chỉ IPv6 trong cùng dải không lách được giới hạn); "dải mạng" = IPv4 /24 hoặc
# IPv6 /48 (một thuê bao / tunnel được cấp cả /56, /48 không chiếm được cả rạp)
# số phòng riêng tối đa cả server (đủ thì thu hồi phòng hết thành viên lâu nhất; không có thì chia đều: người từ dải mạng
# chưa có phòng nào lấy phòng lâu không ai thao tác nhất của dải mạng đang giữ nhiều phòng nhất); mỗi mạng / mỗi dải mạng
# tối đa bao nhiêu phòng đang mở (nhiều người chung một dải 4G CGNAT thì chung giới hạn dải — bị báo "Mạng bạn đang dùng đã
# có nhiều phòng riêng" nhiều thì nới PRIVATE_PER_SUBNET); mỗi mạng tạo tối đa bao nhiêu phòng / giờ
PRIVATE_ROOMS_MAX=400
PRIVATE_PER_NET=3
PRIVATE_PER_SUBNET=6
PRIVATE_CREATE_PER_HOUR=4
# số người tối đa chủ phòng chọn được (2 … giá trị này)
PRIVATE_CAP_MAX=20
# độ dài video tối đa trong phòng riêng (phút) — coi như không giới hạn; mọi luật khác (công khai, cho nhúng, 18+, VN) giữ
# nguyên. Chỉ với video YT_API_KEY kiểm đủ: chưa có / hỏng / hết lượt key (rạp chỉ kiểm cơ bản) thì video phòng riêng vẫn
# theo MAX_VIDEO_MINUTES / LIVE_MAX_MINUTES như rạp chung
PRIVATE_MAX_VIDEO_MINUTES=720
# mỗi người chờ tối đa bao nhiêu video trong phòng riêng
PRIVATE_PER_USER=10
# không còn ai trong phòng bấy nhiêu giây thì tự đóng (đủ lâu để chủ phòng sang Zalo gửi link rồi quay lại)
PRIVATE_EMPTY_SECONDS=180
# không ai thao tác (đi lại, chat, thêm video…) bấy nhiêu phút → tạm dừng video; thêm nữa tới mốc sau → đóng phòng
PRIVATE_IDLE_PAUSE_MINUTES=240
PRIVATE_IDLE_CLOSE_MINUTES=480
