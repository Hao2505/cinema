{
  "name": "vibe-cinema",
  "version": "0.4.8",
  "private": true,
  "description": "Rạp chiếu phim 2D xem YouTube chung: mỗi người xem điều khiển một nhân vật, chat bong bóng, nhảy, thả tim",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx scripts/test-unit.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "npm run typecheck && npm run test:unit && npm run smoke",
    "qa": "tsx scripts/qa.ts",
    "bots": "tsx scripts/bots.ts",
    "share-images": "tsx scripts/share-images.ts",
    "seo-check": "tsx scripts/seo-check.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
